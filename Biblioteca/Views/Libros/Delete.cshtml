@model Biblioteca.Models.Libro
<h2>Eliminar Libro</h2><p>¿Deseas eliminar este registro definitivamente?</p><p><strong>LibroId:</strong> @Model.LibroId</p><p><strong>Titulo:</strong> @Model.Titulo</p><p><strong>AutorId:</strong> @Model.AutorId</p><p><strong>CategoriaId:</strong> @Model.CategoriaId</p><p><strong>Disponible:</strong> @Model.Disponible</p>@if(ViewBag.Error != null) { <p class="error">@ViewBag.Error</p> }<form asp-action="Delete" asp-route-id="@Model.LibroId" method="post">@Html.AntiForgeryToken()<button class="red" type="submit">Sí, eliminar</button> <a class="btn gray" asp-action="Index">Cancelar</a></form>