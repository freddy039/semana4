@model Biblioteca.Models.Libro
<h2>Editar Libro</h2><form asp-action="Edit" method="post">@Html.AntiForgeryToken()<input asp-for="LibroId" type="hidden" /><label asp-for="Titulo"></label><input asp-for="Titulo" required /><span asp-validation-for="Titulo"></span><label asp-for="AutorId"></label><input asp-for="AutorId" type="number" min="1" required /><span asp-validation-for="AutorId"></span><label asp-for="CategoriaId"></label><input asp-for="CategoriaId" type="number" min="1" required /><span asp-validation-for="CategoriaId"></span><label asp-for="Disponible"></label><input asp-for="Disponible" type="checkbox" /><span asp-validation-for="Disponible"></span><p class="actions"><button type="submit">Guardar</button><a class="btn gray" asp-action="Index">Cancelar</a></p></form>