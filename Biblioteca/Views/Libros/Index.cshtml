@model IEnumerable<Biblioteca.Models.Libro>
<h2>Libros</h2><a class="btn" asp-action="Create">+ Nuevo registro</a><div class="scroll"><table><thead><tr><th>LibroId</th><th>Titulo</th><th>AutorId</th><th>CategoriaId</th><th>Disponible</th><th>Acciones</th></tr></thead><tbody>@foreach(var item in Model) {<tr><td>@item.LibroId</td><td>@item.Titulo</td><td>@item.AutorId</td><td>@item.CategoriaId</td><td>@item.Disponible</td><td><div class="actions"><a class="btn orange" asp-action="Edit" asp-route-id="@item.LibroId">Editar</a><a class="btn gray" asp-action="Details" asp-route-id="@item.LibroId">Ver</a><a class="btn red" asp-action="Delete" asp-route-id="@item.LibroId">Eliminar</a></div></td></tr>}</tbody></table></div>