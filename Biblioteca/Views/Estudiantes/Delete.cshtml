@model Biblioteca.Models.Estudiante
<h2>Eliminar Estudiante</h2><p>¿Deseas eliminar este registro definitivamente?</p><p><strong>EstudianteId:</strong> @Model.EstudianteId</p><p><strong>Nombre:</strong> @Model.Nombre</p><p><strong>Apellido:</strong> @Model.Apellido</p><p><strong>Carrera:</strong> @Model.Carrera</p><p><strong>Correo:</strong> @Model.Correo</p>@if(ViewBag.Error != null) { <p class="error">@ViewBag.Error</p> }<form asp-action="Delete" asp-route-id="@Model.EstudianteId" method="post">@Html.AntiForgeryToken()<button class="red" type="submit">Sí, eliminar</button> <a class="btn gray" asp-action="Index">Cancelar</a></form>