@model IEnumerable<Biblioteca.Models.Autor>
<h2>Autores</h2><a class="btn" asp-action="Create">+ Nuevo registro</a><div class="scroll"><table><thead><tr><th>AutorId</th><th>Nombre</th><th>Apellido</th><th>Nacionalidad</th><th>Telefono</th><th>Acciones</th></tr></thead><tbody>@foreach(var item in Model) {<tr><td>@item.AutorId</td><td>@item.Nombre</td><td>@item.Apellido</td><td>@item.Nacionalidad</td><td>@item.Telefono</td><td><div class="actions"><a class="btn orange" asp-action="Edit" asp-route-id="@item.AutorId">Editar</a><a class="btn gray" asp-action="Details" asp-route-id="@item.AutorId">Ver</a><a class="btn red" asp-action="Delete" asp-route-id="@item.AutorId">Eliminar</a></div></td></tr>}</tbody></table></div>