@model Biblioteca.Models.Autor
<h2>Eliminar Autor</h2><p>¿Deseas eliminar este registro definitivamente?</p><p><strong>AutorId:</strong> @Model.AutorId</p><p><strong>Nombre:</strong> @Model.Nombre</p><p><strong>Apellido:</strong> @Model.Apellido</p><p><strong>Nacionalidad:</strong> @Model.Nacionalidad</p><p><strong>Telefono:</strong> @Model.Telefono</p>@if(ViewBag.Error != null) { <p class="error">@ViewBag.Error</p> }<form asp-action="Delete" asp-route-id="@Model.AutorId" method="post">@Html.AntiForgeryToken()<button class="red" type="submit">Sí, eliminar</button> <a class="btn gray" asp-action="Index">Cancelar</a></form>