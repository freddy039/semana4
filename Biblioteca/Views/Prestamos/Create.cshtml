@model Biblioteca.Models.Prestamo
<h2>Registrar Prestamo</h2><form asp-action="Create" method="post">@Html.AntiForgeryToken()<label asp-for="LibroId"></label><input asp-for="LibroId" type="number" min="1" required /><span asp-validation-for="LibroId"></span><label asp-for="EstudianteId"></label><input asp-for="EstudianteId" type="number" min="1" required /><span asp-validation-for="EstudianteId"></span><label asp-for="FechaPrestamo"></label><input asp-for="FechaPrestamo" type="date" required /><span asp-validation-for="FechaPrestamo"></span><label asp-for="FechaDevolucion"></label><input asp-for="FechaDevolucion" type="date" required /><span asp-validation-for="FechaDevolucion"></span><p class="actions"><button type="submit">Guardar</button><a class="btn gray" asp-action="Index">Cancelar</a></p></form>