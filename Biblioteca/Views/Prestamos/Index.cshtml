@model IEnumerable<Biblioteca.Models.Prestamo>
<h2>Prestamos</h2><a class="btn" asp-action="Create">+ Nuevo registro</a><div class="scroll"><table><thead><tr><th>PrestamoId</th><th>LibroId</th><th>EstudianteId</th><th>FechaPrestamo</th><th>FechaDevolucion</th><th>Acciones</th></tr></thead><tbody>@foreach(var item in Model) {<tr><td>@item.PrestamoId</td><td>@item.LibroId</td><td>@item.EstudianteId</td><td>@item.FechaPrestamo</td><td>@item.FechaDevolucion</td><td><div class="actions"><a class="btn orange" asp-action="Edit" asp-route-id="@item.PrestamoId">Editar</a><a class="btn gray" asp-action="Details" asp-route-id="@item.PrestamoId">Ver</a><a class="btn red" asp-action="Delete" asp-route-id="@item.PrestamoId">Eliminar</a></div></td></tr>}</tbody></table></div>