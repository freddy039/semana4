@model Biblioteca.Models.Prestamo
<h2>Eliminar Prestamo</h2><p>¿Deseas eliminar este registro definitivamente?</p><p><strong>PrestamoId:</strong> @Model.PrestamoId</p><p><strong>LibroId:</strong> @Model.LibroId</p><p><strong>EstudianteId:</strong> @Model.EstudianteId</p><p><strong>FechaPrestamo:</strong> @Model.FechaPrestamo</p><p><strong>FechaDevolucion:</strong> @Model.FechaDevolucion</p>@if(ViewBag.Error != null) { <p class="error">@ViewBag.Error</p> }<form asp-action="Delete" asp-route-id="@Model.PrestamoId" method="post">@Html.AntiForgeryToken()<button class="red" type="submit">Sí, eliminar</button> <a class="btn gray" asp-action="Index">Cancelar</a></form>